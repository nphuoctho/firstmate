---
# Per-repo no-mistakes policy for AI Native projects.
# Commit it as <repo>/.no-mistakes.yaml on the DEFAULT branch, then run `no-mistakes init`.
# These fields are read only from the default-branch copy, so a feature-branch edit is ignored:
# commands, agent, review.*, document/test instructions, ci.*, rebase.*, protected_paths, no_ci,
# disable_project_settings.
# Schema: https://github.com/kunchenguid/no-mistakes docs/src/content/docs/reference/repo-config.md
# The repo file ignores unknown or misspelled keys without a warning, and `no-mistakes doctor` and
# `status` do not read it. Check key names against the schema.

# `commands` and `ignore_patterns` are filled in by ai-native/new-project.sh in place of the marker
# line below. Keep the commands: the run worktree has no node_modules or .venv, so without them the
# lint and test steps depend on an agent that may not be able to run anything, and the run can pass.
# Commands run through `sh -c` on the daemon host. Keep them non-interactive.
# ignore_patterns: a pattern with no slash matches that name at any depth. "dir/**" matches a path
# prefix from the repo root. "*" does not cross "/", and "**/" is not a wildcard, so "**/dist/**"
# matches nothing. List each nested build folder on its own line, e.g. "apps/web/dist/**".
# Written by ai-native/new-project.sh (auto). Detected: python (pip, from no lock file) in .;
# A command left out here is not run by the gate. Check each one below.
commands:
  prepare: "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
  lint: ".venv/bin/ruff check ."
  test: ".venv/bin/pytest -q"
  format: ".venv/bin/ruff format ."
ignore_patterns:
  - "*.lock"
  - "*.generated.*"
  - "*.egg-info/**"
  - ".venv/**"
  - "dist/**"
  - "build/**"
  - "__pycache__/**"

# Let the reviewer ask the supervising agent a question instead of guessing.
review:
  conversation: true
  # path_instructions:
  #   - path: "docs/**"
  #     instructions: |
  #       Prose changes only. Do not request test coverage.

# Review findings always wait for a decision. A failing lint or test command also waits, so these
# counts only apply to fixes the agent produced itself.
auto_fix:
  review: 0
  rebase: 3
rc=0
